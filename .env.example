# Copy to .env.local for development.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy
# Used by `npm test` for any DB-backed integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy_test

# --- Demo -------------------------------------------------------------------
# Shows each tile's PIN on the sign-in screen so someone trying this for the
# first time can get in. Throwaway deployments only — see docs/DEPLOY.md.
DEMO_MODE=false

# --- Session signing --------------------------------------------------------
# Any long random string. Signs the staff PIN cookie and team/volunteer magic
# link tokens. Rotating it logs everyone out and invalidates outstanding links.
SESSION_SECRET=dev-only-change-me

# --- Twilio (SMS score intake + broadcasts) ---------------------------------
# Inbound webhook target: POST /api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of these two. A long code sends ~1 message/second; a Messaging
# Service with a toll-free or short code goes much faster and is the answer if
# a broadcast to ninety teams taking three minutes to drain is a problem.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Without a sender configured, production refuses to boot the outbound queue
# rather than silently marking messages sent. Set this to run a deployment
# deliberately without sending real texts — messages go to the log instead.
ALLOW_LOG_SMS=false

# Outbound pacing. Defaults suit a long code; raise the rate for a Messaging
# Service rather than guessing.
SMS_RATE_PER_SECOND=1
SMS_BATCH_LIMIT=50
SMS_DRAIN_MAX_MS=25000

# --- The heartbeat ----------------------------------------------------------
# A scheduler must POST /api/cron/messaging with this as a bearer token, or
# nothing asks for scores and nothing drains the outbound queue. Production
# refuses to run the endpoint when it is unset. See docs/DEPLOY.md step 4.
CRON_SECRET=

# --- Anthropic (score text parsing, server-side only) -----------------------
# Never expose this to the browser. Parsing runs in /api/sms/inbound only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Square (registration, donations, auction, concessions) -----------------
# Not used by the game-operations modules in this build; present so the
# Phase 1 registration work has a home. See DECISIONS.md.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Square developer application id, for the concession till's card handoff.
SQUARE_APPLICATION_ID=
