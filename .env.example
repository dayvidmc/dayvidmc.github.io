# Copy to .env.local for development.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy
# Used by `npm test` for any DB-backed integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy_test

# --- Demo -------------------------------------------------------------------
# Shows each tile's PIN on the sign-in screen so someone trying this for the
# first time can get in. Throwaway deployments only — see docs/DEPLOY.md.
DEMO_MODE=false

# --- Session signing --------------------------------------------------------
# Any long random string. Signs the staff PIN cookie and team/volunteer magic
# link tokens. Rotating it logs everyone out and invalidates outstanding links.
SESSION_SECRET=dev-only-change-me

# --- Twilio (SMS score intake + broadcasts) ---------------------------------
# Inbound webhook target: POST /api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Which provider actually sends. Unset or anything else means the console
# provider: messages are logged and marked sent, and nobody is texted. That is
# deliberate — a stray credential must not be enough to start texting ninety
# coaches during a rehearsal. Set this to `twilio` when you mean it.
SMS_PROVIDER=

# Shared secret for POST /api/notifications/drain, which is what a scheduler
# calls to make queued texts and emails go out. Unset means the endpoint is
# closed, and then nothing sends unless somebody presses the button in HQ.
SENDER_TOKEN=

# --- Email ------------------------------------------------------------------
# The same rule as SMS: unset means the console provider, which writes the
# message to the log and marks it sent. Set to `resend` when you mean it.
#
# This one blocks entry-taking rather than merely degrading it — the entry
# confirmation is what carries a coach's reference, and a coach without their
# reference cannot pay. It needs a sending domain with SPF and DKIM published,
# which is a DNS conversation with whoever administers the domain.
MAIL_PROVIDER=
RESEND_API_KEY=
# The address it comes from, e.g. "Tokessy Tournament <entries@example.org>".
MAIL_FROM=
# Where a reply should land. Leave blank to let replies go to MAIL_FROM.
MAIL_REPLY_TO=

# --- Anthropic (score text parsing, server-side only) -----------------------
# Never expose this to the browser. Parsing runs in /api/sms/inbound only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Square (registration, donations, auction, concessions) -----------------
# Not used by the game-operations modules in this build; present so the
# Phase 1 registration work has a home. See DECISIONS.md.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Square developer application id, for the concession till's card handoff.
SQUARE_APPLICATION_ID=
