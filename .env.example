# Copy to .env.local for development.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy
# Used by `npm test` for any DB-backed integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy_test

# --- Demo -------------------------------------------------------------------
# Shows each tile's PIN on the sign-in screen so someone trying this for the
# first time can get in. Throwaway deployments only — see docs/DEPLOY.md.
DEMO_MODE=false

# --- Session signing --------------------------------------------------------
# Any long random string. Signs the staff PIN cookie and team/volunteer magic
# link tokens. Rotating it logs everyone out and invalidates outstanding links.
SESSION_SECRET=dev-only-change-me

# --- Twilio (SMS score intake + broadcasts) ---------------------------------
# Inbound webhook target: POST /api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Preferred over TWILIO_FROM_NUMBER. A long code sends roughly one message a
# second, so a ~180-message broadcast takes three minutes to drain — and
# Saturday evening has several bursts overlapping. A Messaging Service pools
# numbers and handles throughput. Set one or the other; the service wins.
TWILIO_MESSAGING_SERVICE_SID=
# Log messages instead of sending them. Development only — never in production,
# where "no credentials, so pretend it worked" is how a hundred texts nobody
# received get reported as delivered.
SMS_DRY_RUN=false
# Messages sent per tick. The tick runs every 30s, so a backlog drains across
# several runs rather than holding one request open for minutes.
SMS_BATCH_SIZE=25

# --- The sender (cron) ------------------------------------------------------
# Shared secret for POST /api/tick, which is what actually sends anything.
# Without it the endpoint refuses to run in production — the endpoint spends
# money and texts volunteers, so it cannot be open. See docs/DEPLOY.md.
CRON_SECRET=

# --- Anthropic (score text parsing, server-side only) -----------------------
# Never expose this to the browser. Parsing runs in /api/sms/inbound only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Square (registration, donations, auction, concessions) -----------------
# Not used by the game-operations modules in this build; present so the
# Phase 1 registration work has a home. See DECISIONS.md.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Square developer application id, for the concession till's card handoff.
SQUARE_APPLICATION_ID=
