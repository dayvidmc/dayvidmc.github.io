# Copy to .env.local for development.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy
# Used by `npm test` for any DB-backed integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tokessy_test

# --- Demo -------------------------------------------------------------------
# Shows each tile's PIN on the sign-in screen so someone trying this for the
# first time can get in. Throwaway deployments only — see docs/DEPLOY.md.
DEMO_MODE=false

# --- Session signing --------------------------------------------------------
# Any long random string. Signs the staff PIN cookie and team/volunteer magic
# link tokens. Rotating it logs everyone out and invalidates outstanding links.
SESSION_SECRET=dev-only-change-me

# --- Twilio (SMS score intake + broadcasts) ---------------------------------
# Inbound webhook target: POST /api/sms/inbound
# With none of these set, outbound messages print to the server log instead of
# being delivered — fine for development, refused in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service over a single number: a long code sends about one
# message per second, so a broadcast to 90 teams takes three minutes to drain.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Twilio's API host. Only set this for a regional endpoint, or to point the
# failure path at a dead socket in testing.
# TWILIO_API_BASE=https://api.twilio.com
# Force the console transport even with credentials present.
# SMS_TRANSPORT=console

# --- Outbound worker --------------------------------------------------------
# The worker runs inside the web process. Set to `off` to stop it — messages
# then queue and stay queued until something calls POST /api/jobs/tick.
# SMS_WORKER=off
# SMS_WORKER_INTERVAL_SECONDS=30
# Messages sent per pass, and the gap between them when sending from a single
# long code (ignored when a Messaging Service is configured).
# SMS_MESSAGES_PER_TICK=25
# SMS_MIN_INTERVAL_MS=1100

# --- Manual / external tick -------------------------------------------------
# Bearer token for POST /api/jobs/tick. Unset, the endpoint is disabled.
CRON_SECRET=

# --- Anthropic (score text parsing, server-side only) -----------------------
# Never expose this to the browser. Parsing runs in /api/sms/inbound only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Square (registration, donations, auction, concessions) -----------------
# Not used by the game-operations modules in this build; present so the
# Phase 1 registration work has a home. See DECISIONS.md.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Square developer application id, for the concession till's card handoff.
SQUARE_APPLICATION_ID=
